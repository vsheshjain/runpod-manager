# RunPod Manager — API credentials
#
# Copy to .env and paste your key:   cp .env.example .env
# .env is gitignored. Never commit a real key.
#
# ---------------------------------------------------------------------------
# HOW TO GET AN API KEY
# ---------------------------------------------------------------------------
#   1. https://console.runpod.io -> Settings -> API Keys -> Create API Key.
#   2. Name it (e.g. "runpod-manager-agent"). Full access unless you want a
#      restricted key.
#   3. Copy it now — it is shown once. Paste below.
#
# The key can create (and bill for) GPUs and delete volumes. Treat it like a
# password: no chat, no commits, no memory files. Revoke from the same screen
# if leaked.
#
# Smoke test:   bin/rp doctor     or     bin/rp pod list
# ---------------------------------------------------------------------------

RUNPOD_API_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL — endpoint overrides (leave unset for prod)
# ---------------------------------------------------------------------------
# RUNPOD_API_URL=https://rest.runpod.io/v1
# RUNPOD_GRAPHQL_URL=https://api.runpod.io/graphql
# RUNPOD_INVOKE_URL=https://api.runpod.ai/v2
# RUNPOD_REST_V2_URL=https://api.runpod.io/v2
