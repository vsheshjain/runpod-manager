# RunPod Manager — API credentials
#
# Copy to .env and paste your key:   cp .env.example .env
# .env is gitignored. Never commit a real key.
#
# ---------------------------------------------------------------------------
# HOW TO GET AN API KEY
# ---------------------------------------------------------------------------
#   (https://docs.runpod.io/get-started/credentials#create-an-api-key)
#   1. Open https://console.runpod.io/user/credentials
#   2. API Keys tab -> Create API Key.
#   3. Name it (e.g. "runpod-manager-agent") and pick permissions:
#        All        - full access (needed to create/stop/delete resources)
#        Restricted - per-endpoint access (None / Read Only / Read/Write)
#        Read Only  - inspect only; every mutation will fail
#   4. Create, then click the new key to copy it. RunPod does not store it.
#      Paste below.
#
# The key can create (and bill for) GPUs and delete volumes. Treat it like a
# password: no chat, no commits, no memory files. Revoke it on the same
# Credentials -> API Keys tab (trash icon -> Revoke Key) if leaked.
#
# Smoke test:   bin/rp doctor     or     bin/rp pod list
# ---------------------------------------------------------------------------

RUNPOD_API_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL — endpoint overrides (leave unset for prod)
# ---------------------------------------------------------------------------
# RUNPOD_API_URL=https://rest.runpod.io/v1
# RUNPOD_GRAPHQL_URL=https://api.runpod.io/graphql
# RUNPOD_INVOKE_URL=https://api.runpod.ai/v2
# RUNPOD_REST_V2_URL=https://api.runpod.io/v2
